name = "thalys-free-backend"
main = "worker.js"
compatibility_date = "2026-09-01"

[vars]
# Inserisci ESATTAMENTE il dominio pubblico di Thalys, senza slash finale.
ALLOWED_ORIGIN = "https://YOUR-THALYS-DOMAIN.example"
GOOGLE_CLIENT_ID = "YOUR_WEB_OAUTH_CLIENT_ID.apps.googleusercontent.com"
# Copia qui la chiave pubblica generata da generate-keys.mjs. Non e un segreto.
VAPID_PUBLIC_KEY = "YOUR_VAPID_PUBLIC_KEY"

[[d1_databases]]
binding = "DB"
database_name = "thalys-free"
database_id = "YOUR_D1_DATABASE_ID"

# Segreti da aggiungere con Wrangler, MAI da scrivere in questo file:
# npx wrangler secret put GOOGLE_CLIENT_SECRET
# npx wrangler secret put AUTH_ENCRYPTION_KEY
# npx wrangler secret put VAPID_PRIVATE_KEY
