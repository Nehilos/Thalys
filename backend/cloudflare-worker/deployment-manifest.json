{
  "appVersion": "0.46.0",
  "contractVersion": "1",
  "provider": "cloudflare-workers-free",
  "billingRequired": false,
  "photos": "google-drive-only",
  "appData": "google-drive-plus-indexeddb",
  "activation": {
    "backendEnabledDefault": false,
    "googleCodeFlowEnabledDefault": false,
    "autoActivate": false
